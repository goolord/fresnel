/// The parameter endpoints, which hosts automate and save. Whenever one changes, all the values go
/// out together to whatever the graph connects `out` to.
processor Params
{
    output event params::Values out;

    input event float distance [[ name: "Distance", min: 0, max: 250, init: 12, unit: "ms" ]];
    input event float chroma [[ name: "Chroma", min: -1, max: 1, init: 0.3499999940395355 ]];
    input event float aperture [[ name: "Aperture", min: 0.05000000074505806, max: 1, init: 0.699999988079071 ]];
    input event float intensity [[ name: "Intensity", min: -1, max: 1, init: 0.25 ]];
